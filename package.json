{
  "name": "tapak-nusa",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "node scripts/with-build-phase.mjs next build",
    "build:worker": "node scripts/with-build-phase.mjs opennextjs-cloudflare build",
    "start": "opennextjs-cloudflare preview",
    "format": "oxfmt",
    "generate:importmap": "payload generate:importmap",
    "generate:types": "payload generate:types",
    "generate:db-schema": "payload generate:db-schema",
    "payload": "payload",
    "deploy": "opennextjs-cloudflare deploy",
    "cf:typegen": "wrangler types",
    "typecheck": "tsc --noEmit",
    "d1:migrate:local": "payload migrate",
    "d1:migrate:remote": "wrangler d1 migrations apply tapak-nusa-db --remote"
  },
  "dependencies": {
    "@payloadcms/db-d1-sqlite": "4.0.0-beta.7",
    "@payloadcms/next": "4.0.0-beta.7",
    "@payloadcms/plugin-cloud-storage": "4.0.0-beta.7",
    "@payloadcms/richtext-lexical": "4.0.0-beta.7",
    "@payloadcms/storage-r2": "4.0.0-beta.7",
    "@payloadcms/translations": "4.0.0-beta.7",
    "@payloadcms/ui": "4.0.0-beta.7",
    "graphql": "^16.8.1",
    "html-react-parser": "^5.2.10",
    "monaco-editor": "0.55.1",
    "next": "16.4.6",
    "payload": "4.0.0-beta.7",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.17",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "24.12.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "oxfmt": "^0.73.0",
    "postcss": "^8.5.0",
    "tailwindcss": "^4.0.0",
    "typescript": "6.0.3",
    "wrangler": "^4.162.0"
  },
  "engines": {
    "node": ">=24.22.1",
    "pnpm": "^9 || ^10 || ^11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "unrs-resolver",
      "workerd"
    ]
  }
}
